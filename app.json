{
  "expo": {
    "name": "Plastic Brains",
    "slug": "therapy-app-frontend",
    "version": "1.0.0",
    "scheme": "therapyapp",
    "orientation": "portrait",
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brain-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "codemoore"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-iap"
    ],
    "splash": {
      "image": "./assets/brain-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/brain-logo.png",
      "bundleIdentifier": "com.plastic-brains.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "therapyapp"
            ]
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d802148d-ed84-4010-9b6f-bd727d76af94"
      }
    }
  }
}
