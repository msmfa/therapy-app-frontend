# Environment template
# Copy this file to `.env` for local development and set the values for your dev backend.
# Copy it again to `.env.production` for release builds and update the values to match production.

#######################################
# Development defaults (local backend) #
#######################################

# API surface consumed by the app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Expo Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sentry configuration (set either EXPO_PUBLIC_SENTRY_DSN or SENTRY_DSN)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Used by Sentry CLI during builds (keep out of version control)
SENTRY_AUTH_TOKEN=

# Apple Sign In
EXPO_PUBLIC_APPLE_SERVICE_ID=
EXPO_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/apple/callback

# OAuth endpoint override (leave blank to use defaults)
EXPO_PUBLIC_OAUTH_ENDPOINT=

# Store listing URLs (required for production builds)
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
# Optional web store destination
EXPO_PUBLIC_WEB_STORE_URL=https://your-web-storefront.example.com

######################################
# Production reference (fill & copy) #
######################################
# EXPO_PUBLIC_API_URL=https://www.plastic-brains.com
# EXPO_PUBLIC_APPLE_SERVICE_ID=com.yourcompany.therapyapp
# EXPO_PUBLIC_APPLE_REDIRECT_URI=https://www.plastic-brains.com/api/auth/oauth/apple/callback
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
# EXPO_PUBLIC_WEB_STORE_URL=https://www.plastic-brains.com
